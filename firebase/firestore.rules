rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function approvedUser() {
      return signedIn() && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true;
    }
    match /profiles/{profileId} {
      allow read, write: if approvedUser();
    }
    match /authorizedUsers/{uid} {
      // Provision authorization records from Firebase Console/admin tooling only.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
