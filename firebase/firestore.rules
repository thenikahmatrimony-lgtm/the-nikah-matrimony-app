rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRecord() { return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)); }
    function approvedUser() { return signedIn() && userRecord().data.active == true; }
    function owner() { return approvedUser() && userRecord().data.owner == true; }
    match /profiles/{profileId} {
      allow read, create, update: if approvedUser();
      allow delete: if owner();
    }
    match /authorizedUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}