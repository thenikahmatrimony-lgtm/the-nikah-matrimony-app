rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approvedUser() {
      return request.auth != null && firestore.get(/databases/(default)/documents/authorizedUsers/$(request.auth.uid)).data.active == true;
    }
    function owner() {
      return approvedUser() && firestore.get(/databases/(default)/documents/authorizedUsers/$(request.auth.uid)).data.owner == true;
    }
    match /profilePhotos/{profileId}/{fileName} {
      allow read, create, update: if approvedUser();
      allow delete: if owner();
    }
  }
}